{
  "manifest_version": 3,
  "name": "Тихие заметки",
  "version": "0.3.1",
  "minimum_chrome_version": "122",
  "description": "Личные Markdown-заметки в вашей папке: теги, поиск и корзина.",
  "permissions": ["sidePanel"],
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "action": {"default_title": "Открыть заметки", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}},
  "side_panel": {"default_path": "index.html"},
  "background": {"service_worker": "background.js"},
  "options_page": "index.html"
}
